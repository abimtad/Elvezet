{
  "name": "salon-booking-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for a salon booking marketplace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && tsx watch src/server.ts",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:privacy": "tsx src/tests/privacy-safety.integration.ts",
    "test:ratings": "tsx src/tests/trustworthy-ratings.integration.ts",
    "test:product-reviews": "tsx src/tests/product-reviews.integration.ts",
    "test:verify": "tsx src/tests/verify-et.test.ts && tsx src/tests/verify-booking.integration.ts",
    "lint": "eslint .",
    "seed:mustdash": "tsx src/scripts/seedMustDash.ts",
    "seed:mustdash-reviews": "tsx src/scripts/seedMustDashReviews.ts",
    "recalc:ratings": "tsx src/scripts/recalculateBusinessRatings.ts",
    "seed:demo-marketplace": "tsx src/scripts/seedDemoMarketplace.ts",
    "seed:discover": "tsx src/scripts/seedDiscover.ts",
    "enable:shop-products": "tsx src/scripts/enableShopProducts.ts",
    "update:mustdash-location": "tsx src/scripts/updateMustDashLocation.ts",
    "setup:dev": "docker compose up -d && npm run seed:mustdash",
    "test:notifications": "tsx src/tests/notifications.integration.ts",
    "test:sms": "tsx src/tests/sms.integration.ts",
    "notifications:check": "tsx src/scripts/checkNotificationReadiness.ts",
    "test:tickets": "tsx src/tests/booking-ticket.integration.ts",
    "test:ticket-archive": "tsx src/tests/customer-ticket-archive.integration.ts"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "bullmq": "^5.71.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.1.1",
    "mongoose": "^9.3.2",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "sharp": "^0.34.5",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3"
  },
  "license": "MIT"
}
