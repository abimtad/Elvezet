NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/barber_os?retryWrites=true&w=majority
# Local Docker Redis, OR Upstash TCP (not the REST URL):
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:UPSTASH_TOKEN@YOUR-ENDPOINT.upstash.io:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Firebase (required by env validator — use placeholders for local dev if needed)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Verify.ET payment receipt verification (server-side only — never ship to clients)
VERIFY_ET_API_KEY=VERIFY_BANK_ET_...
VERIFY_ET_BASE_URL=https://verify.et
# Optional: webhook HMAC secret from Verify.ET dashboard (whsec_...)
VERIFY_ET_WEBHOOK_SECRET=
APP_URL=http://127.0.0.1:5000

# Live SMS: set these in Render's environment settings; never commit the API key.
SMS_PROVIDER=smsethiopia
SMS_ENABLED=true
SMS_DRY_RUN=false
SMS_API_KEY=
